# ==============================================================================
# AMS (Attendance Management System) - Cloudflare Workers Production Configuration
# Duplicate this file as 'wrangler.toml' and replace the database and KV IDs.
# ==============================================================================

name = "ams"
main = "src/server/index.ts"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]

# ------------------------------------------------------------------------------
# Static Assets Binding (Single Page Application & PWA Shell)
# ------------------------------------------------------------------------------
[assets]
directory = "./dist"
binding = "ASSETS"

# ------------------------------------------------------------------------------
# Cloudflare D1 Database Binding (SQLite at the Edge)
# Provision database: wrangler d1 create ams-db
# Apply migrations:   wrangler d1 migrations apply ams-db --remote
# ------------------------------------------------------------------------------
[[d1_databases]]
binding = "DB"
database_name = "ams-db"
database_id = "YOUR_D1_DATABASE_ID_HERE"
migrations_dir = "src/db/migrations"

# ------------------------------------------------------------------------------
# Cloudflare KV Namespace Binding (Session Revocation & Token Cache)
# Provision namespace: wrangler kv:namespace create ams-kv
# ------------------------------------------------------------------------------
[[kv_namespaces]]
binding = "KV"
id = "YOUR_KV_NAMESPACE_ID_HERE"

# ------------------------------------------------------------------------------
# Public & Server Environment Variables ([vars])
# NOTE: SENSITIVE SECRETS MUST NEVER BE COMMITTED TO WRANGLER.TOML.
# Store production secrets securely using Cloudflare Secrets:
#   1. wrangler secret put SESSION_SECRET  (Generate: openssl rand -hex 32)
#   2. wrangler secret put QR_KEY_K1       (Generate: openssl rand -base64 32)
#   3. wrangler secret put QR_KEY_K2       (Standby key for zero-downtime rotation)
# ------------------------------------------------------------------------------
[vars]
ENVIRONMENT = "production"
ENABLE_GUEST_CONVERSION = "true"

# Domain & Token Boundaries
APP_DOMAIN = "ccunbaja.web.id"
APP_ISSUER = "https://ams.ccunbaja.web.id"
APP_AUDIENCE = "ams"

# Whitelisted Production CORS Origins (comma-separated)
ALLOWED_ORIGINS = "https://ams.ccunbaja.web.id,https://ams.humanone.workers.dev"

# Whitelisted QR Token Issuers for Scanner Verification (comma-separated)
TRUSTED_ISSUERS = "https://ams.ccunbaja.web.id,https://absen.local,https://ams.humanone.workers.dev"

# Active Key Identifier for JWE signing ('k1' or 'k2')
QR_ACTIVE_KID = "k1"
