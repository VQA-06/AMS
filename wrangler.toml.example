# ==============================================================================
# AMS (Attendance Management System) - Cloudflare Configuration Template
# Duplicate this file as 'wrangler.toml' and replace the database and KV IDs.
# ==============================================================================

name = "ams"
main = "src/server/index.ts"
compatibility_date = "2024-11-01"
compatibility_flags = ["nodejs_compat"]

[assets]
directory = "./dist"
binding = "ASSETS"

# ------------------------------------------------------------------------------
# Cloudflare D1 Database Binding
# Create database via CLI: wrangler d1 create ams-db
# Apply migrations: wrangler d1 migrations apply ams-db --remote
# ------------------------------------------------------------------------------
[[d1_databases]]
binding = "DB"
database_name = "ams-db"
database_id = "YOUR_D1_DATABASE_ID_HERE"
migrations_dir = "src/db/migrations"

# ------------------------------------------------------------------------------
# Cloudflare KV Namespace Binding (Optional Session Cache)
# Create namespace via CLI: wrangler kv:namespace create ams-kv
# ------------------------------------------------------------------------------
[[kv_namespaces]]
binding = "KV"
id = "YOUR_KV_NAMESPACE_ID_HERE"

# ------------------------------------------------------------------------------
# Public & Server Environment Variables
# For sensitive production secrets, use `wrangler secret put <KEY>`:
# - wrangler secret put QR_KEY_K1
# - wrangler secret put SESSION_SECRET
# ------------------------------------------------------------------------------
[vars]
ENVIRONMENT = "production"
QR_ACTIVE_KID = "k1"
APP_ISSUER = "https://ams.yourdomain.com"
APP_AUDIENCE = "ams"
